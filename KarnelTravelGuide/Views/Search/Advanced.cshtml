@model SearchViewModel
@{ ViewData["Title"] = "Advanced Search"; Model.Fill(Catalog); }
@{
    var q = string.IsNullOrWhiteSpace(Model.Q) ? null : Model.Q.Trim();
    var hpic = Model.Highlight != null ? Images.LocalPic(Model.Highlight) : null;
    var banner = new[] { q == null ? "Advanced Search" : "Results for \u201c" + q + "\u201d", q == null ? "Filter by price, quality, quantity and availability" : Model.Results.Count() + " place(s) found", "", hpic != null ? $"url({hpic})" : "none" };
}
<partial name="_Banner" model="banner" />
<main>
  <form method="get" class="filters">
    <input name="q" value="@Model.Q" placeholder="Keyword" />
    <select name="cat"><option value="">All categories</option>@foreach (var c in Catalog.Titles) { <option value="@c.Key" selected="@(Model.Cat == c.Key)">@c.Value</option> }</select>
    <input name="city" value="@Model.City" placeholder="Location" />
    <input name="minPrice" type="number" value="@Model.MinPrice" placeholder="Min price" />
    <input name="maxPrice" type="number" value="@Model.MaxPrice" placeholder="Max price" />
    <select name="rating"><option value="">Any quality</option>@foreach (var r in new[]{"3","4","4.5"}) { <option value="@r" selected="@(Model.Rating?.ToString() == r)">@r+ stars</option> }</select>
    <input name="qty" type="number" value="@Model.Qty" placeholder="Min rooms/seats" />
    <select name="sort">
      <option value="">Sort: Name</option>
      <option value="price-asc" selected="@(Model.Sort == "price-asc")">Price: low to high</option>
      <option value="price-desc" selected="@(Model.Sort == "price-desc")">Price: high to low</option>
      <option value="rating" selected="@(Model.Sort == "rating")">Best rated</option>
    </select>
    <label><input type="checkbox" name="avail" value="true" checked="@Model.Avail" /> Available only</label>
    <button>Search</button><a class="btn alt" href="/Search">← Simple Search</a>
  </form>
  <partial name="_SearchResults" model="Model" />
</main>
