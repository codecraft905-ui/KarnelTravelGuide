@{
    ViewData["Title"] = "Reset Password";
}
<main class="authsplit">
  <aside class="authvisual" style="background-image:@Html.Raw(Images.Bg("mountains", 7, 1400, 1000))">
    <h2>Almost <em>there</em>.</h2>
    <p>Your identity is verified. Choose a new password for your account.</p>
  </aside>
  <section class="authpanel">
  <div class="formcard loginbox">
    <h2>Create New Password</h2>
    @if (ViewBag.Error != null)
    {
      <div class="err" role="alert">@ViewBag.Error</div>
    }
    <form asp-controller="Account" asp-action="ResetPassword" method="post" class="form">
      <input type="hidden" name="email" value="@ViewBag.Email" />
      <input type="hidden" name="token" value="@ViewBag.Token" />
      <label>New Password<input type="password" name="password" minlength="6" maxlength="100" autocomplete="new-password" required autofocus /></label>
      <label>Confirm Password<input type="password" name="confirmPassword" minlength="6" maxlength="100" autocomplete="new-password" required /></label>
      <button>Reset Password</button>
    </form>
  </div>
  </section>
</main>
