@{
    ViewData["Title"] = "Forgot Password";
}
<main class="authsplit">
  <aside class="authvisual" style="background-image:@Html.Raw(Images.Bg("mountains", 7, 1400, 1000))">
    <h2>Let us help you <em>back in</em>.</h2>
    <p>Enter your registered email and we will send a 6-digit verification code to it.</p>
  </aside>
  <section class="authpanel">
  <div class="formcard loginbox">
    <h2>Forgot Password</h2>
    <p class="meta">Enter your registered email address. We will email you a code that is valid for 5 minutes.</p>
    @if (ViewBag.Error != null)
    {
      <div class="err" role="alert">@ViewBag.Error</div>
    }
    <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="form">
      <label>Email Address<input type="email" name="email" maxlength="150" autocomplete="username" required autofocus /></label>
      <button>Send Code</button>
    </form>
    <p class="meta" style="margin-bottom:0"><a asp-controller="Account" asp-action="Login"><b><u>Back to Login</u></b></a></p>
  </div>
  </section>
</main>
